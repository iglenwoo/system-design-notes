  {"type":"text","id":"foot","x":60,"y":660,"width":1300,"height":66,"text":"The gate is per-process, so N app processes still send N queries — better, not solved. A Redis SET NX EX lock collapses it across the fleet.\nBut reach for TTL jitter first: keys warmed together expire together, and smearing their expiry costs one line and prevents the herd from\nforming at all. Single-flight is for the keys hot enough to stampede on their own.","originalText":"The gate is per-process, so N app processes still send N queries — better, not solved. A Redis SET NX EX lock collapses it across the fleet.\nBut reach for TTL jitter first: keys warmed together expire together, and smearing their expiry costs one line and prevents the herd from\nforming at all. Single-flight is for the keys hot enough to stampede on their own.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":500119,"version":1,"versionNonce":500120,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
 ],
