  {"type":"text","id":"r2t","x":290,"y":769,"width":780,"height":20,"text":"Key absent either way.   Next read reloads B.   Order cannot matter.","originalText":"Key absent either way.   Next read reloads B.   Order cannot matter.","fontSize":15,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400067,"version":1,"versionNonce":400068,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"r2","lineHeight":1.25},

  {"type":"text","id":"foot","x":60,"y":836,"width":1100,"height":44,"text":"SET carries the writers' order into the cache, and that order can invert. DELETE carries no value, so there is nothing to invert —\nwhoever deletes last still leaves the key absent. Deletion is idempotent; assignment is not.","originalText":"SET carries the writers' order into the cache, and that order can invert. DELETE carries no value, so there is nothing to invert —\nwhoever deletes last still leaves the key absent. Deletion is idempotent; assignment is not.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400069,"version":1,"versionNonce":400070,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
 ],
